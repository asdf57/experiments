#include <stdlib.h>
#include <stdio.h>
#include <unistd.h>
#include <stdint.h>

int main() {
	pid_t pid, pid2;

	pid = fork();
	if (pid == -1) {
		perror("fork");
		exit(EXIT_FAILURE);
	}
	if (pid == 0) {
		pid_t curpid;
		curpid = getpid();
		printf("I am child 1 with pid: %jd\n", curpid);

		pid2 = fork();
		if (pid2 == -1) {
			perror("fork");
			exit(EXIT_FAILURE);
		}

		exit(EXIT_SUCCESS);
	}

	printf("I am the parent. Child is PID %jd\n", (intmax_t) pid);
	puts("Parent exiting.");
	exit(EXIT_SUCCESS);
}
